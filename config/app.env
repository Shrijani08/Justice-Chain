# Settings bundled into the app. Nothing secret goes here: the APK can be
# unzipped by anyone. The Pinata key and the gateway API key live only on
# the laptop (fabric/gateway/pinata-jwt.txt, api-key.txt) and the SOS device.
#
# Ledger: "fabric" (gateway below) or "evm" (local Hardhat; needs RPC_URL,
# CONTRACT_ADDRESS and HARDHAT_SUBMITTER_PRIVATE_KEY added here, dev only).
LEDGER=fabric
# The gateway through the ngrok tunnel (fabric/gateway/start-tunnel.sh).
GATEWAY_URL=https://grandly-riverside-showy.ngrok-free.dev
